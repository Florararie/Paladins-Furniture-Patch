{
	"schemaVersion": 1,
	"id": "paladins_furniture_patch",
	"version": "${version}",
	"name": "Polymer Patch for Paladin's Furniture",
	"description": "Server-side-only Paladin's Furniture: furniture renders from its own models and textures for unmodded clients.",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"eu.pb4.paladinsfurniturepatch.PaladinsFurniturePatch"
		]
	},
	"mixins": [
		"paladins-furniture-patch.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"polymer-core": ">=0.16.0",
		"polymer-blocks": ">=0.16.0",
		"polymer-virtual-entity": ">=0.16.0",
		"sgui": ">=2.0.0",
		"polymer-resource-pack": ">=0.16.0",
		"pfm": ">=1.5.1"
	}
}
